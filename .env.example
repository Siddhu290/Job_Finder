# ======================================================================
# Fresher Data Job Finder — configuration. Copy to .env (chmod 600). Never commit .env.
# Two modes:
#   single-user : Google Sheets is the database (default when DATABASE_URL is empty)
#   multi-user  : Neon Postgres is the database (set DATABASE_URL); Sheets is optional export only
# ======================================================================

# ---- Search ----
SERPAPI_KEY=                     # server key: single-user mode, or admins in multi-user mode (users can save their own in Settings)
SERPAPI_MAX_CALLS=30             # max SerpApi searches per run
SERPAPI_MONTHLY_LIMIT=250        # safety limit per SerpApi account per month
TIMEZONE=Asia/Kolkata
JOB_MAX_AGE_DAYS=7

# ---- Google Sheets ----
# single-user mode: the database.  multi-user mode: optional, every user gets their own tab "Jobs - <email>".
GOOGLE_SHEET_ID=1oivue0amQNqJQbEzX32UJFieK8rn24NnUpufpt3Lvug
GOOGLE_CREDENTIALS=credentials.json      # path to the service-account JSON (on Vercel use GOOGLE_CREDENTIALS_JSON instead)
DASHBOARD_PASSWORD=                      # dashboard password (single-user mode only)

# ---- Multi-user mode (Neon Postgres) ----
# STORAGE_BACKEND=postgres               # optional; DATABASE_URL alone switches to postgres
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require   # Neon POOLED url (app)
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require # Neon DIRECT url (migrations)
# SESSION_SECRET=                        # 32+ random chars:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# SECRETS_KEY=                           # encrypts users' saved SerpApi keys:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# ALLOW_SIGNUP=true                      # anyone can create an account (each user needs their own SerpApi key to search)
# INVITE_CODE=                           # optional: also require this code to sign up

# ---- AI (resume analysis & tailoring) ----
LLM_API_KEY=                             # free key: https://console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b             # default; a retired model falls back automatically

# ---- Vercel ----
# CRON_SECRET=                           # Vercel Cron sends it; protects /api/run

# ---- Job sources (optional; defaults shown). See docs/ARCHITECTURE.md "Discovery sources". ----
# Providers in priority order. company_pages and ats_boards are free; google_jobs, linkedin and naukri cost one SerpApi search per query.
# DISCOVERY_PROVIDERS=company_pages,ats_boards,google_jobs,linkedin,naukri
# LINKEDIN_QUERIES=2              # Google "site:linkedin.com/jobs/view" searches per run (LinkedIn pages are never fetched)
# NAUKRI_QUERIES=2                # Google "site:naukri.com/job-listings" searches per run (Naukri pages are never fetched)
# COMPANY_PAGES_PER_RUN=8         # official careers pages crawled per run (employers already identified)
# CAREERS_TTL_DAYS=7              # re-crawl a careers page after this many days
# DISCOVERY_CONCURRENCY=5         # parallel discovery tasks (max 10)
# SOURCE_TIERS={"Naukri": 3}      # override a source's preference tier (1 company/ATS, 2 trusted platform, 3 supplementary)
# CRON_TIME_BUDGET=270            # seconds per Vercel cron invocation (maxDuration is 300)
# CRON_USER_SECONDS=110           # time slice per user within a cron invocation
